{
  "name": "@playwright-guru/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright Guru browser extension \u2014 the WXT/Manifest V3 runtime that wraps locator-engine and codegen into an installable Chrome extension.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .wxt .output"
  },
  "dependencies": {
    "@playwright-guru/locator-engine": "workspace:*",
    "@playwright-guru/codegen": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "wxt": "0.20.0",
    "@wxt-dev/module-react": "^1.2.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
