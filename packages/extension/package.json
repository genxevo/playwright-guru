{
  "name": "@playwright-guru/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright Guru browser extension \u2014 the WXT/Manifest V3 runtime that wraps locator-engine and codegen into an installable Chrome extension.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build -c wxt.e2e.config.ts",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .wxt .output .output-e2e",
    "package": "node scripts/validate-package.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.mjs"
  },
  "dependencies": {
    "@playwright-guru/locator-engine": "workspace:*",
    "@playwright-guru/codegen": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "wxt": "0.20.0",
    "@wxt-dev/module-react": "^1.2.2",
    "@types/chrome": "^0.2.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
